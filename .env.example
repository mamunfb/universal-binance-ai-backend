APP_NAME=Universal Binance AI Backend
APP_ENV=development
LOG_LEVEL=INFO

# Optional shared PostgreSQL/Neon database for persistent market-data stores.
# Configure the pooled Neon connection string in your hosting provider's secret
# environment settings; never commit a real URL or password to Git.
DATABASE_URL=
# Optional override for historical klines; falls back to DATABASE_URL when empty.
HISTORICAL_KLINE_DATABASE_URL=
BINANCE_SPOT_BASE_URL=https://api.binance.com
HTTP_TIMEOUT_SECONDS=15

# Exact browser origins allowed to call the API (comma-separated; no wildcard).
# Example after creating Cloudflare Pages: https://your-project.pages.dev
# Local development may use http://localhost:3000; remote HTTP origins are rejected.
CORS_ALLOWED_ORIGINS=

# Live liquidation stream collector (requires a persistent always-on process)
LIQUIDATION_COLLECTOR_ENABLED=false
LIQUIDATION_DATABASE_PATH=data/liquidations.sqlite3
# PostgreSQL lease lifetime in seconds (5-3600); renewals run at roughly one-third of this value.
LIQUIDATION_COLLECTOR_LEASE_TTL_SECONDS=30

# Sequence-aware local order-book depth stream collector (disabled by default).
# Configure explicit jobs, e.g. [{"market":"USD_M","symbol":"BTCUSDT"}].
ORDER_BOOK_COLLECTOR_ENABLED=false
ORDER_BOOK_COLLECTOR_JOBS=[]
ORDER_BOOK_DATABASE_PATH=data/order_book_history.sqlite3
ORDER_BOOK_SAMPLE_INTERVAL_SECONDS=1
ORDER_BOOK_SNAPSHOT_LIMIT=1000
ORDER_BOOK_STORED_LEVELS=20

# Optional aggregate trade stream collector; configure same market/symbol pairs as order book jobs.
AGGREGATE_TRADE_COLLECTOR_ENABLED=false
AGG_TRADE_COLLECTOR_JOBS=[]
AGGREGATE_TRADE_DATABASE_PATH=data/aggregate_trades.sqlite3
# PostgreSQL lease lifetime in seconds (5-3600); renewals run at roughly one-third of this value.
AGGREGATE_TRADE_COLLECTOR_LEASE_TTL_SECONDS=30

# Scheduled historical candle collector (disabled by default).
# Use one persistent application process and persistent disk for SQLite.
HISTORICAL_KLINE_DATABASE_PATH=data/historical_klines.sqlite3
FUNDING_RATE_DATABASE_PATH=data/funding_rates.sqlite3
OPEN_INTEREST_DATABASE_PATH=data/open_interest.sqlite3
DERIVATIVES_SIGNAL_DATABASE_PATH=data/derivatives_signals.sqlite3
DERIVATIVES_RATIO_DATABASE_PATH=data/derivatives_ratios.sqlite3
MARKET_CONFLUENCE_DATABASE_PATH=data/market_confluence.sqlite3
DERIVATIVES_COLLECTOR_ENABLED=false
# Example allow-list: one funding series and one open-interest series.
# Enable only after checking each contract is currently tradable.
DERIVATIVES_COLLECTOR_JOBS=[{"type":"FUNDING_RATE","symbol":"BTCUSDT"},{"type":"OPEN_INTEREST","symbol":"BTCUSDT","period":"1h"}]
DERIVATIVES_COLLECTOR_POLL_SECONDS=60
DERIVATIVES_COLLECTOR_FUNDING_LIMIT=1000
DERIVATIVES_COLLECTOR_OPEN_INTEREST_LIMIT=500
# PostgreSQL lease lifetime in seconds (5-3600); renewals run at roughly one-third of this value.
DERIVATIVES_COLLECTOR_LEASE_TTL_SECONDS=30
HISTORICAL_COLLECTOR_ENABLED=false
# Explicit allow-list only; example below is disabled until enabled above.
HISTORICAL_COLLECTOR_JOBS=[]
# Poll cadence (seconds); minimum 10.
HISTORICAL_COLLECTOR_POLL_SECONDS=30
# Initial recent window when a series has no stored candles.
HISTORICAL_COLLECTOR_INITIAL_LIMIT=500
# PostgreSQL lease lifetime in seconds (5-3600); renewals run at roughly one-third of this value.
HISTORICAL_COLLECTOR_LEASE_TTL_SECONDS=30

# Optional RSS/Atom sources; use publisher-provided HTTPS feeds only.
# Format: Source Name=https://publisher.example/rss.xml;Another Source=https://example.org/feed
NEWS_RSS_FEEDS=
NEWS_PRIMARY_SOURCE_DOMAINS=
NEWS_INDEPENDENT_SOURCE_DOMAINS=
NEWS_STALE_AFTER_HOURS=168

# Optional read-only EVM JSON-RPC provider. Use an HTTPS endpoint.
EVM_RPC_URL=
EVM_CHAIN_NAME=
# Optional manually verified wallet labels: Exchange A=0xAddress,Exchange B=0xAddress
EVM_EXCHANGE_ADDRESSES=
EVM_MAX_LOG_BLOCK_SPAN=2000
EVM_TRANSFER_DATABASE_PATH=data/evm_transfers.sqlite3
EVM_INDEX_MAX_TOTAL_BLOCKS=10000
# Optional operator-maintained EVM wallet attribution JSON array. Verified entries require HTTPS evidence_url and evidence_note.
EVM_WALLET_REGISTRY=[]

# Optional read-only multi-chain wallet snapshots. JSON array of {chain_id, rpc_url, chain_name}.
# Each RPC endpoint must use HTTPS and report the configured chain_id.
EVM_CHAIN_RPC_URLS=[]

# Operator-defined cross-chain ERC-20 asset groups; contracts must be verified manually.
EVM_CHAIN_TOKEN_CONTRACTS=[]
